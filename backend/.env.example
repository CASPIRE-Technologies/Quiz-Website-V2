# Database Environment Variables
# Supabase Postgres direct connection.
# Replace [YOUR-PASSWORD] with the database password from Supabase Project Settings.
# If your network is IPv4-only, use the Supabase shared pooler connection string instead.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lsevpalyovjjgkjfmmfs.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=8000

# Legacy local MySQL fallback, used only when DATABASE_URL is missing or still contains [YOUR-PASSWORD].
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=quiz_platform_db

# Server Configuration
PORT=5000
NODE_ENV=development
